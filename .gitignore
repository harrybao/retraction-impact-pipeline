.venv/
__pycache__/
*.pyc
data/mhtml/
# PDFs supplied by publishers (IOP, via the University's CAUL licence) for TDM
# processing only. Same reason as data/mhtml/: publisher copyright, never to be
# redistributed, so never committed.
data/pdf/
data/interim/*.sqlite
data/interim/*.sqlite-*

# Derived caches: the citation panel is rebuilt from the share bundle in a
# couple of minutes by citation_panel(), so it is not worth 4 MB of history.
data/interim/*.rds
data/reports/*.json
.pytest_cache/
.env

# cleaned outputs are derived: regenerate with scripts/clean_data.py
data/clean/*.csv
data/clean/*.csv.gz
data/clean/*.jsonl.gz

# share bundle: regenerate as needed, not version-controlled
cs43-share.zip

# Public copy: the dataset never enters this repository (see README, Data availability)
data/share/
data/clean/
data/llm/
data/labelling/
data/raw/
data/controls/
data/interim/
deliverables/
docs/worklog.md
docs/project-report.md
docs/client-minutes-*.md
docs/status-check-*.md

# run logs: regenerated on every run, never part of the dataset
logs/

# Correspondence with publishers and the library. Never version-controlled:
# it carries third parties' names and email addresses, the terms individual
# publishers offered us, and - in the SFTP thread - a residential IP address.
# Two of these were tracked by mistake and are removed in the same commit as
# this line. Drafts live here for us to work on; they do not go to a repository
# the group and the client can read.
docs/emails/

# stray capture written by a debug run
.t.bin

# Labelling sheets and keys: Altmetric text under the client's licence, shared
# with the team directly, never committed. Regenerate: analysis/labelling_sample.R
data/labelling/

# Model answers. Same reason: every answer carries an `evidence` field quoting
# the item or notice it read, so these files hold licensed Altmetric text and
# publisher notice text. Regenerate: analysis/llm_classify_corpus.R. The
# numbers derived from them go to data/reports/, which is committed.
data/llm/

# R: renv library and targets store are local
_targets/

# R-side secrets (OPENALEX_API_KEY): never committed
.Renviron

# Control group: OpenAlex data and a 17,728-file cache, regenerated by
# R/control_group.R. Only the summary is tracked.
data/controls/*
!data/controls/controls_v1_summary.csv

# The Retraction Watch CSV travels with the handover dataset, not in git.
data/raw/

# run_pipeline() output and save_page() files: the user's own runs
/runs/

# Outside reviews and their working files (GPT audits, form QA): never committed
gpt/
